generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String?   @unique
  password      String?
  discordId     String?   @unique
  discordName   String?
  avatar        String?
  xp            Int       @default(0)
  level         Int       @default(1)
  createdAt     DateTime  @default(now())

  submissions   Submission[]
  quizAttempts  QuizAttempt[]
}

model Submission {
  id          String   @id @default(cuid())
  userId      String
  challengeId Int
  passed      Boolean
  code        String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

model QuizAttempt {
  id         String   @id @default(cuid())
  userId     String
  questionId Int
  correct    Boolean
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
}